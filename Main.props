<?xml version="1.0" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- The mod ID (also the BepInEx plugin GUID) is read from About/About.xml's <ModID>. -->
    <AssemblyName>AutominerFix</AssemblyName>
    <Description>Fixes the base game's Autominer leaving alternating voxels untouched at the corners of a vertical pit.</Description>
    <!-- Optional: set StationeersDirectory in Local.Developer.props if the game isn't found automatically. -->
  </PropertyGroup>
  <ItemGroup>
    <!--
      Template/libs holds stub game DLLs for CI. SDK globbing adds them as None items, and
      MSBuild resolves candidate files before HintPaths, so without this the build silently
      compiles against the stubs (an older game version) instead of StationeersDllDir.
    -->
    <None Remove="Template/libs/**" />
  </ItemGroup>
</Project>
